# .env file usage for acceptance tests:
# This file contains environment variables required for the terraform provider's acceptance tests.
# The '.env' file is automatically loaded when acceptance tests are run.
#
# To use:
# 1. Copy the .env.template file to .env.
# 2. Add your specific environment variable values to the new .env file.

LIGHTDASH_URL="<YOUR LIGHTDASH HOST>"
LIGHTDASH_API_KEY="<LIGHTDASH API KEY>"
LIGHTDASH_PROJECT="<LIGHTDASH PROJECT UUID>"
# Optional: Only if set, the acceptance tests for org-level role member are executed
#LIGHTDASH_TEST_ORG_MEMBER_EMAIL

# lightdash_project acceptance tests create a real project. Destroy only removes Terraform state.
# They run only when LIGHTDASH_URL equals LIGHTDASH_TEST_SANDBOX_URL,
# or when LIGHTDASH_TEST_ALLOW_PRODUCTION=1. Leave both unset to skip those tests.
#LIGHTDASH_TEST_SANDBOX_URL
#LIGHTDASH_TEST_ALLOW_PRODUCTION
